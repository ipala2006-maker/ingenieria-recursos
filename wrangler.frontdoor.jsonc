{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "7dc38ab200688eea2a1a951a04225fa4",
  "name": "estudiemos",
  "main": "cloudflare/frontdoor.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/materia/*", "/amistad/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "services": [{ "binding": "BACKEND", "service": "estudiemos-candidate" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "invocation_logs": false } }
}
