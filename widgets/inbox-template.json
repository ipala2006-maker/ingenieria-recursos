{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "ESTUDIEMOS", "size": "Small", "weight": "Bolder", "color": "Accent", "spacing": "None" },
            { "type": "TextBlock", "text": "Inbox", "size": "Large", "weight": "Bolder", "spacing": "Small" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${taskCount}", "size": "Large", "weight": "Bolder", "color": "Accent", "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    { "type": "TextBlock", "text": "${task1}", "weight": "Bolder", "wrap": true, "maxLines": 1, "separator": true, "isVisible": "${task1Visible}" },
    { "type": "TextBlock", "text": "${task1Meta}", "size": "Small", "color": "Accent", "spacing": "None", "wrap": true, "maxLines": 1, "isVisible": "${task1Visible}" },
    { "type": "TextBlock", "text": "${task2}", "weight": "Bolder", "wrap": true, "maxLines": 1, "separator": true, "isVisible": "${task2Visible}" },
    { "type": "TextBlock", "text": "${task2Meta}", "size": "Small", "color": "Accent", "spacing": "None", "wrap": true, "maxLines": 1, "isVisible": "${task2Visible}" },
    { "type": "TextBlock", "text": "${task3}", "weight": "Bolder", "wrap": true, "maxLines": 1, "separator": true, "isVisible": "${task3Visible}" },
    { "type": "TextBlock", "text": "${task3Meta}", "size": "Small", "color": "Accent", "spacing": "None", "wrap": true, "maxLines": 1, "isVisible": "${task3Visible}" },
    { "type": "TextBlock", "text": "${emptyText}", "horizontalAlignment": "Center", "color": "Default", "spacing": "Large", "isVisible": "${emptyVisible}" }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Abrir Inbox", "verb": "open-inbox" }
  ]
}
