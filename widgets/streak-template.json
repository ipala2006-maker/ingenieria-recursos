    { "type": "TextBlock", "text": "ESTUDIEMOS", "size": "Small", "weight": "Bolder", "color": "Accent", "horizontalAlignment": "Center" },
    { "type": "TextBlock", "text": "🔥", "size": "ExtraLarge", "horizontalAlignment": "Center", "spacing": "Medium" },
