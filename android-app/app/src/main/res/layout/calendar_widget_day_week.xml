<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_day_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="48dp" android:background="@drawable/calendar_day_background"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
    <TextView android:id="@+id/calendar_day_number"
        android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center"
        android:textColor="#F1F5F9" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/calendar_day_events"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="5"
        android:textColor="#B8D2FF" android:textSize="12sp" />
</LinearLayout>
