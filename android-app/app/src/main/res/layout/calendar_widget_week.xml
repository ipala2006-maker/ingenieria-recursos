<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical" android:padding="12dp">
    <include layout="@layout/calendar_widget_header" />
    <GridView android:id="@+id/calendar_widget_grid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:numColumns="1" android:stretchMode="columnWidth" android:verticalSpacing="4dp" android:scrollbars="vertical" />
    <TextView android:id="@+id/calendar_widget_footer"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"
        android:gravity="end" android:text="Abrir calendario" android:textColor="#8BB5FF" android:textSize="11sp" />
</LinearLayout>
