{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estudiemos-candidate",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/materia/*", "/amistad/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "vars": {
    "APP_ORIGIN": "https://estudiemos-candidate.estudiemos-services.workers.dev",
    "PUSH_DISPATCH_ENABLED": "false"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
