# Optional official organic API connectors. Leave blank for manual publishing.
# Never paste tokens in the browser, Git, issues, PRs or chats.
SOCIAL_INSTAGRAM_ENABLED=false
SOCIAL_META_API_VERSION=
SOCIAL_INSTAGRAM_USER_ID=
SOCIAL_INSTAGRAM_PAGE_TOKEN=

SOCIAL_YOUTUBE_ENABLED=false
# Set true only AFTER Google approves this API project for public uploads.
SOCIAL_YOUTUBE_AUDITED=false
SOCIAL_YOUTUBE_CHANNEL_ID=
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_YOUTUBE_REFRESH_TOKEN=

# Optional paths if FFmpeg / FFprobe are not on PATH.
SOCIAL_FFMPEG=ffmpeg
SOCIAL_FFPROBE=ffprobe
SOCIAL_PORT=8147
