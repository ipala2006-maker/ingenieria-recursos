{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/widget-push.js": {
      "maxDuration": 60
    },
    "api/whatsapp-webhook.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/widget.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/downloads/Estudiemos-Widgets.rmskin",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Estudiemos-Widgets.rmskin\""
        }
      ]
    },
    {
      "source": "/downloads/Activar-Alarmas-Estudiemos.exe",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Activar-Alarmas-Estudiemos.exe\"" },
        { "key": "Cache-Control", "value": "no-cache, max-age=0" }
      ]
    },
    {
      "source": "/downloads/Estudiemos-Widgets-para-Windows.exe",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Estudiemos-Widgets-para-Windows.exe\"" }
      ]
    },
    {
      "source": "/downloads/Agregar-Mi-Espacio-Estudiemos.exe",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Agregar-Mi-Espacio-Estudiemos.exe\"" }]
    },
    {
      "source": "/downloads/Agregar-Inbox-Estudiemos.exe",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Agregar-Inbox-Estudiemos.exe\"" }]
    },
    {
      "source": "/downloads/Agregar-Calendario-Estudiemos.exe",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Agregar-Calendario-Estudiemos.exe\"" }]
    },
    {
      "source": "/downloads/Agregar-Pomodoro-Estudiemos.exe",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Agregar-Pomodoro-Estudiemos.exe\"" }]
    },
    {
      "source": "/downloads/Agregar-Racha-Estudiemos.exe",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Agregar-Racha-Estudiemos.exe\"" }]
    },
    {
      "source": "/downloads/Estudiemos-Para-Windows.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Estudiemos-Para-Windows.exe\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.112.3/dist/umd/supabase.min.js https://challenges.cloudflare.com 'sha256-7hyFoFyyc4iyY8F/+OG2I6FBbxO7kdDecQiv8RLYkz0=' 'sha256-9jXCXI8+uMfWyfJghvbtV1Qxt7fy3VdkJRnWqHxv74Y=' 'sha256-B03/Z5j46CcVVw+9JpYBHpOShK5lEPVoV14uPqU48d0=' 'sha256-OGzK6U4An6xAiEgFeb7wUMf8VfUm6Cz8x3x5dDof3+k=' 'sha256-Q30dRTn+5j8p/lyvshTLTC09EiWHQ0Dj7wvB3t4JQhQ=' 'sha256-S+neRQ8JK2wOfU2ov21vZT2IlG0s3t0iOFH6ZGXcDa8=' 'sha256-bv/VeVd5oCZrDeQ7NuurodrfZwxd4PSLjazERjsttgg=' 'sha256-h/MKFLGv0R82L4w9IKc/lXQJkYdqWsLoK+JJ5NZ8hFs=' 'sha256-oaKZR5P1gcbVy2i103IY+MNivNnmUxVOx6/uLfQ5BBY='; script-src-attr 'unsafe-hashes' 'sha256-1NmhG4hcqwlKSnKoIHQAsotK8rdoxwP5B/KnxRkiTqI=' 'sha256-3SQzhHzI0TqP4KF5YgsRQplM1yFdSvd/xq0VrUQ5c9w=' 'sha256-ODrQrwDEPTdyIetSs12VaGGJ3NL3g4jiFoFpN33nPQU=' 'sha256-pN8IcLHsCTYKFxIgPOW4QXsm2dxmjuL25Js32FEkBMc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.youtube.com https://i.ytimg.com; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://noembed.com https://*.supabase.co wss://*.supabase.co; frame-src estudiemos-widgets: https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://docs.google.com; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
