{
  "name": "estudiemos-services",
  "private": true,
  "version": "1.0.0",
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "google-auth-library": "11.3.1",
    "web-push": "3.6.7"
  },
  "scripts": {
    "cloudflare:build": "node scripts/build-cloudflare.cjs",
    "cloudflare:check": "npm run cloudflare:build && wrangler deploy --dry-run --outdir tmp/cloudflare-bundle",
    "cloudflare:dev": "npm run cloudflare:build && wrangler dev --ip 127.0.0.1 --port 8190",
    "cloudflare:deploy": "npm run cloudflare:build && wrangler deploy",
    "db:restore-test": "node scripts/restore-database-test.cjs",
    "test:mobile": "node --test tests/mobile-notifications.test.cjs tests/mobile-push-indexed.test.cjs tests/widget-push.test.cjs tests/android-widget-sync.test.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "wrangler": "4.154.0"
  }
}
