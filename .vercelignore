# The social studio runs locally. Never deploy its data or credentials.
.social-studio/
marketing/social-studio/

# Local credentials and test artifacts are never public assets.
**/.env*
.vercel/
tmp/
tests/
.backups/
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*service-account*.json

# Operational source and reports are not application assets.
docs/
supabase/
windows-installer/
android-app/
google-apps-script/
.github/
scripts/security-check.js
scripts/csp-check.js
