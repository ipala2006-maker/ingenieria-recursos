# Clave privada opcional de Google AI Studio. Solo en el backend, nunca en el navegador.
GEMINI_API_KEY=

# Modelo estable usado por el asistente de agenda.
GEMINI_MODEL=gemini-3.5-flash-lite

# Datos publicos del proyecto Supabase usado para cuentas y sincronizacion.
# La publishable key puede enviarse al navegador; nunca usar una secret/service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Primary server origin. Legacy deployments keep their own original APP_ORIGIN.
APP_ORIGIN=https://estudiemos.estudiemos-services.workers.dev

# Clave privada de servidor de Supabase. Solo como Secret del backend.
SUPABASE_SECRET_KEY=

# Token largo usado solo por el sincronizador privado de la hoja Usuarios.
USER_REGISTRY_EXPORT_TOKEN=

# Identificador publico de Cloudflare Turnstile. La clave secreta se configura en Supabase Auth.
TURNSTILE_SITE_KEY=

# Secreto aleatorio opcional para anonimizar identificadores del rate limit.
# Si no se configura, el servidor deriva esta protección de SUPABASE_SECRET_KEY.
RATE_LIMIT_SECRET=

# Secreto privado para convertir teléfonos verificados en huellas no reversibles.
# Usar al menos 32 caracteres y no cambiarlo mientras existan cuentas verificadas.
REFERRAL_PHONE_HASH_SECRET=

# Notificaciones silenciosas para actualizar widgets Android con la app cerrada.
# FIREBASE_SERVICE_ACCOUNT_JSON es privada y solo debe configurarse como Secret del backend.
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Integracion oficial de WhatsApp Business Cloud API.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_DAILY_COMMAND_LIMIT=30
# Mobile Web Push: server-only private key and cron token, never in HTML.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_KEY_ID=
MOBILE_PUSH_CRON_SECRET=

# Google Drive: official OAuth web client, configured only on the backend.
# Exact primary callback: https://estudiemos.estudiemos-services.workers.dev/api/account-config?drive=callback
# Keep the legacy callback authorized until existing clients have migrated.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Legacy AES key: retain only where legacy envelopes still need to be read.
# Never replace an existing key in place. Use the versioned migration procedure.
DRIVE_TOKEN_ENCRYPTION_KEY=
# Versioned AES keys: server-only JSON mapping key IDs to 64-character hex keys.
DRIVE_TOKEN_KEYRING=
DRIVE_TOKEN_ACTIVE_KEY_ID=
GOOGLE_DRIVE_APP_ORIGIN=https://estudiemos.estudiemos-services.workers.dev
# Optional, server-only: verified Estudiemos account emails allowed during initial testing.
# Keep the pilot restriction until real Google consent/upload/revocation and public OAuth are verified.
GOOGLE_DRIVE_PILOT_EMAILS=
# Optional metadata-only My Drive browsing; configure Google first and keep the pilot until review.
GOOGLE_DRIVE_BROWSE_ENABLED=false
